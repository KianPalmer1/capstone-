import math
import random
import re

from nltk.stem import PorterStemmer
from sklearn.ensemble import RandomForestClassifier
from sklearn.feature_extraction.text import TfidfVectorizer


class DataLoader:
    """
    Handles data preprocessing, loading, and splitting.
    """

    @staticmethod
    def preprocess(text):
        # Convert text to lowercase
        text = text.lower()

        # Remove special characters
        text = re.sub(r'[^a-zA-Z0-9\s]', '', text)

        # Split text into individual words
        words = text.split()

        # Create a PorterStemmer object
        stemmer = PorterStemmer()

        # Apply stemming to each word
        words = [stemmer.stem(word) for word in words]

        return words

    @staticmethod
    def load_data(file_path):

        x, y = [], []

        # Open the dataset
        with open(file_path, 'r', encoding='utf-8') as file:

            # Loop through each line
            for line in file:

                # Split label and message
                parts = line.strip().split('\t', 1)

                if len(parts) != 2:
                    continue

                label, message = parts

                # Convert labels to numbers
                if label == 'spam':
                    y.append(1)
                elif label == 'ham':
                    y.append(0)
                else:
                    continue

                # Preprocess message and append to x
                x.append(DataLoader.preprocess(message))

        return x, y

    @staticmethod
    def split_data(x, y, test_ratio=0.2):

        # Create a list of indexes
        indices = list(range(len(x)))

        # Shuffle the indexes
        random.shuffle(indices)

        # Calculate split point
        split_point = int(len(x) * (1 - test_ratio))

        # Divide indexes into training and testing
        train_indices = indices[:split_point]
        test_indices = indices[split_point:]

        # Create training and testing datasets
        x_train = [x[i] for i in train_indices]
        x_test = [x[i] for i in test_indices]

        y_train = [y[i] for i in train_indices]
        y_test = [y[i] for i in test_indices]

        return x_train, x_test, y_train, y_test


class RandomForestModel:
    """
    Handles training and prediction using a Random Forest classifier.
    """

    def __init__(self):

        # Initialize TF-IDF vectorizer
        self.vectorizer = TfidfVectorizer(
            tokenizer=str.split,
            preprocessor=None,
            token_pattern=None,
            lowercase=False
        )

        # Initialize Random Forest classifier
        self.model = RandomForestClassifier(
            n_estimators=200,
            max_features='sqrt',
            random_state=42,
            class_weight='balanced',
            n_jobs=-1
        )

    def train(self, train_X, train_y):

        # Convert token lists into strings
        train_messages = [' '.join(words) for words in train_X]

        # Convert messages into numerical TF-IDF features
        X_train_vectorized = self.vectorizer.fit_transform(
            train_messages
        )

        # Train the Random Forest model
        self.model.fit(X_train_vectorized, train_y)

    def prediction(self, messages):

        # Convert token lists into strings
        messages_text = [' '.join(words) for words in messages]

        # Convert messages using the fitted TF-IDF vectorizer
        messages_vectorized = self.vectorizer.transform(
            messages_text
        )

        # Predict spam or ham
        predictions = self.model.predict(messages_vectorized)

        return predictions.tolist()


class EvaluationMetrics:

    @staticmethod
    def compute_metrics(y_true, y_pred):

        # Initialize matrix values
        TP = 0
        TN = 0
        FP = 0
        FN = 0

        # Compare actual and predicted labels
        for actual, predicted in zip(y_true, y_pred):

            if actual == 1 and predicted == 1:
                TP += 1

            elif actual == 0 and predicted == 0:
                TN += 1

            elif actual == 0 and predicted == 1:
                FP += 1

            elif actual == 1 and predicted == 0:
                FN += 1

        # Calculate accuracy
        accuracy = (TP + TN) / len(y_true)

        # Calculate precision
        if TP + FP == 0:
            precision = 0
        else:
            precision = TP / (TP + FP)

        # Calculate recall
        if TP + FN == 0:
            recall = 0
        else:
            recall = TP / (TP + FN)

        # Calculate F1 score
        if precision + recall == 0:
            f1_score = 0
        else:
            f1_score = (
                2 * precision * recall
            ) / (precision + recall)

        # Return results
        return {
            "TP": TP,
            "TN": TN,
            "FP": FP,
            "FN": FN,
            "Accuracy": accuracy,
            "Precision": precision,
            "Recall": recall,
            "F1 Score": f1_score
        }


def main():

    # Load dataset
    x, y = DataLoader.load_data(
        r"C:\Users\palme\Downloads\SMSSpamCollection.txt"
    )

    print("Dataset loaded successfully!")
    print("Total messages:", len(x))

    # Split data
    x_train, x_test, y_train, y_test = DataLoader.split_data(x, y)

    print("Training samples:", len(x_train))
    print("Testing samples:", len(x_test))

    # Create and train Random Forest model
    model = RandomForestModel()
    model.train(x_train, y_train)

    # Make predictions
    train_predictions = model.prediction(x_train)
    test_predictions = model.prediction(x_test)

    # Calculate metrics
    train_metrics = EvaluationMetrics.compute_metrics(
        y_train, train_predictions
    )

    test_metrics = EvaluationMetrics.compute_metrics(
        y_test, test_predictions
    )

    # Write results
    with open("results.txt", "w", encoding="utf-8") as file:

        file.write("RANDOM FOREST CLASSIFIER RESULTS\n\n")

        file.write(f"Training samples: {len(x_train)}\n")
        file.write(f"Testing samples: {len(x_test)}\n\n")

        file.write("TRAINING RESULTS:\n")

        for key, value in train_metrics.items():
            file.write(f"{key}: {value}\n")

        file.write("\nTESTING RESULTS:\n")

        for key, value in test_metrics.items():
            file.write(f"{key}: {value}\n")

    print("Results saved to results.txt")


if __name__ == "__main__":
    main()
