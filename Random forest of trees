
import pandas as pd

from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.impute import SimpleImputer
from sklearn.pipeline import Pipeline

from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)


class DataLoader:
    """
    Handles data preprocessing, loading, and splitting.
    """
 
    @staticmethod
       @staticmethod
    def load_data(file_path):

        # Load agricultural dataset
        df = pd.read_csv(file_path)

        print("Dataset loaded successfully!")
        print(df.head())

        return df

   
    @staticmethod
    def prepare_data(df):

        # Select numerical input features
        features = [
            'Leaf Wetness',
            'Temperature',
            'Humidity',
            'Chlorophyll',
            'Color Changes',
            'GDD'
        ]

        # Input data
        X = df[features]

        # Target variable
        y = df['Downy Mildew']

        return X, y

  

class RandomForestModel:
    """
    Handles training and prediction using a Random Forest classifier.
    """
 def __init__(self):

        # Handle missing values and train classifier
        self.model = Pipeline([
            ('imputer', SimpleImputer(strategy='median')),

            ('classifier', RandomForestClassifier(
                n_estimators=200,
                max_features='sqrt',
                random_state=42,
                class_weight='balanced',
                n_jobs=-1
            ))
        ])

    def train(self, X_train, y_train):

        self.model.fit(X_train, y_train)

        print("Random Forest training completed!")

    def predict(self, X_test):

        return self.model.predict(X_test)

    def predict_probability(self, X_test):

        return self.model.predict_proba(X_test)

    def feature_importance(self):

        classifier = self.model.named_steps['classifier']

        return classifier.feature_importances_

class EvaluationMetrics:

     @staticmethod
    def evaluate(y_test, predictions):

        accuracy = accuracy_score(y_test, predictions)

        precision = precision_score(
            y_test, predictions, zero_division=0
        )

        recall = recall_score(
            y_test, predictions, zero_division=0
        )

        f1 = f1_score(
            y_test, predictions, zero_division=0
        )

        print("\nMODEL PERFORMANCE")

        print("Accuracy:", accuracy)
        print("Precision:", precision)
        print("Recall:", recall)
        print("F1 Score:", f1)

        print("\nConfusion Matrix:")
        print(confusion_matrix(y_test, predictions))

        print("\nClassification Report:")
        print(classification_report(
            y_test,
            predictions,
            zero_division=0
        ))



def main():

    # Load dataset
    df = DataLoader.load_data(
        "agricultural_data.csv"
    )

    # Prepare input features and target
    X, y = DataLoader.prepare_data(df)

    # Split dataset into training and testing
    X_train, X_test, y_train, y_test = train_test_split(
        X,
        y,
        test_size=0.20,
        random_state=42,
        stratify=y
    )

    print("\nTraining samples:", len(X_train))
    print("Testing samples:", len(X_test))

    # Initialize Random Forest
    model = RandomForestModel()

    # Train model
    model.train(X_train, y_train)

    # Make predictions
    predictions = model.predict(X_test)

    # Evaluate model
    EvaluationMetrics.evaluate(
        y_test,
        predictions
    )

    # Display feature importance
    importance = model.feature_importance()

    print("\nFEATURE IMPORTANCE")

    for feature, value in zip(X.columns, importance):

        print(feature, ":", round(value, 4))

    # Example: Predict probability of disease
    probabilities = model.predict_probability(X_test)

    print("\nDISEASE PREDICTION PROBABILITIES")

    for i, probability in enumerate(probabilities):

        print(
            "Sample", i + 1,
            "| No Disease:", round(probability[0], 3),
            "| Disease:", round(probability[1], 3)
        )


if __name__ == "__main__":
    main()
